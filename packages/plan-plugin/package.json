{
  "name": "@photo-sphere-viewer/plan-plugin",
  "version": "0.0.0",
  "description": "Photo Sphere Viewer 平面图插件，用于通过 Leaflet 添加地理地图。",
  "homepage": "https://photo-sphere-viewer.js.org/plugins/plan.html",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "keywords": [
    "map",
    "leaflet",
    "cartography"
  ],
  "dependencies": {
    "@photo-sphere-viewer/core": "workspace:*",
    "leaflet": "^1.9.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "instrument": "nyc instrument dist/index.module.js .",
    "lint": "tsc --noEmit && eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "publish-dist": "cd dist && npm publish --tag=$NPM_TAG --access=public",
    "npm-link": "cd dist && npm link"
  },
  "psv": {
    "title": "Photo Sphere Viewer / 平面图插件",
    "style": true,
    "budget": "30kb"
  }
}
