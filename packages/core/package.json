{
  "name": "@photo-sphere-viewer/core",
  "version": "0.0.0",
  "description": "用于展示 360° 全景图的 JavaScript 核心库。",
  "homepage": "https://photo-sphere-viewer.js.org",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "three": "^0.184.0"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "instrument": "nyc instrument dist/index.module.js .",
    "lint": "tsc --noEmit && eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "test": "NODE_OPTIONS='--import tsx' mocha \"src/**/*.spec.ts\"",
    "publish-dist": "cd dist && npm publish --tag=$NPM_TAG --access=public",
    "npm-link": "cd dist && npm link"
  },
  "psv": {
    "title": "全景图查看器",
    "style": true,
    "budget": "200kb"
  },
  "devDependencies": {
    "tsx": "^4.22.3"
  }
}
