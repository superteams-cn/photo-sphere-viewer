{
  "name": "@photo-sphere-viewer/resolution-plugin",
  "version": "0.0.0",
  "description": "全景图查看器画质插件，用于在多个全景图分辨率之间切换。",
  "homepage": "https://photo-sphere-viewer.js.org/plugins/resolution.html",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@photo-sphere-viewer/core": "workspace:*",
    "@photo-sphere-viewer/settings-plugin": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "instrument": "nyc instrument dist/index.module.js .",
    "lint": "tsc --noEmit && eslint . --fix",
    "publish-dist": "cd dist && npm publish --tag=$NPM_TAG --access=public",
    "npm-link": "cd dist && npm link"
  },
  "psv": {
    "title": "全景图查看器：画质插件",
    "budget": "10kb"
  }
}
