{
  "name": "@photo-sphere-viewer/gyroscope-plugin",
  "version": "0.0.0",
  "description": "Photo Sphere Viewer 陀螺仪插件，用于移动端控制。",
  "homepage": "https://photo-sphere-viewer.js.org/plugins/gyroscope.html",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@photo-sphere-viewer/core": "workspace:*",
    "three": "^0.184.0"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "instrument": "nyc instrument dist/index.module.js .",
    "lint": "tsc --noEmit && eslint . --fix",
    "publish-dist": "cd dist && npm publish --tag=$NPM_TAG --access=public",
    "npm-link": "cd dist && npm link"
  },
  "psv": {
    "title": "Photo Sphere Viewer / 陀螺仪插件",
    "budget": "15kb"
  }
}
