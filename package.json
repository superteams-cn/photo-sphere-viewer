{
  "name": "@photo-sphere-viewer/parent",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "build",
    "docs",
    "cypress",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "turbo telemetry disable",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "eslint . --fix && stylelint \"packages/**/src/**/*.{css,scss}\" \"examples/**/*.{css,scss}\" --fix && prettier . --write",
    "format:check": "prettier . --check",
    "test": "turbo run test",
    "serve": "turbo run watch --concurrency 50",
    "serve-filter": "run() { read filters; turbo run watch --concurrency 50 $filters; }; FORCE_COLOR=true node ./build/select-packages.mjs | run",
    "npm-link": "turbo run npm-link --output-logs=new-only",
    "doc:build": "turbo run build-doc",
    "doc:serve": "turbo run serve-doc",
    "ci:build": "turbo run lint build test --concurrency=100%",
    "ci:e2e": "turbo run build instrument --concurrency=100% -- --env.E2E && node ./build/start-and-test.mjs \"watch --e2e\" \"e2e:run\"",
    "ci:version": "npm version --workspace packages --workspaces-update false",
    "ci:publish": "turbo run publish-dist --concurrency=1",
    "e2e:open": "cypress open --e2e --browser=electron",
    "e2e:run": "cypress run --e2e --browser=electron",
    "build-doc": "node ./build/generate-typedoc-readme.mjs && typedoc --out public/api",
    "watch": "node ./build/liveserver.mjs"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@lcov-viewer/istanbul-report": "^1.4.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/mocha": "^10.0.9",
    "@types/three": "^0.183.1",
    "alive-server": "^1.3.0",
    "chalk": "^5.6.2",
    "cypress": "^15.15.0",
    "cypress-mochawesome-reporter": "^4.0.0",
    "cypress-on-fix": "^1.1.0",
    "cypress-visual-regression": "^5.3.0",
    "enquirer": "^2.4.1",
    "esbuild": "^0.28.0",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.3.5",
    "glob": "^10.4.5",
    "globals": "^17.6.0",
    "lodash": "^4.18.1",
    "mocha": "^11.7.1",
    "mocha-junit-reporter": "^2.2.1",
    "nyc": "^18.0.0",
    "postcss": "^8.5.1",
    "prettier": "^3.8.3",
    "pretty-bytes": "^7.1.0",
    "queue": "^7.0.0",
    "selfsigned": "^5.5.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^7.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "turbo": "^2.8.17",
    "typedoc": "^0.28.17",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3",
    "yaml": "^2.9.0",
    "yargs": "^17.7.2"
  },
  "pnpm": {
    "overrides": {
      "yargs": "^17.7.2",
      "nyc": "^17.1.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "cypress",
      "esbuild"
    ]
  }
}
